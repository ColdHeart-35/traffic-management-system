# Copy to .env (or export these in your shell). No secrets are committed; these are local demo values.
TMS_DATABASE_URL=sqlite:///./tms.db
TMS_SENSOR_API_KEY=sensor-demo-key
TMS_AUTOTICK=1          # 1 = signals advance once a second in the background
TMS_SEED_DEMO=1         # 1 = create demo users and one intersection when the database is empty
TMS_TOKEN_HOURS=8
TMS_TLS_CERT=certs/tms-cert.pem
TMS_TLS_KEY=certs/tms-key.pem
